# Copy file này thành .env.local rồi chỉnh nếu cần.
# Bỏ trống / xoá dòng dưới thì app dùng thẳng https://dummyjson.com
#
# Khi API công khai chết hoặc lớp học không có internet, chạy server mirror
# (xem Phụ lục A trong DummyJSON-Thuc-hanh.md) rồi trỏ về đây:
VITE_API_URL=https://dummyjson.com

# LƯU Ý: Vite chỉ đọc file .env lúc khởi động.
# Sửa xong phải tắt và chạy lại `npm run dev`.
